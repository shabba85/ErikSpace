# Copy to .env.  Never commit .env.
# The system runs without any of these -- it just has fewer sources and will
# say so in provenance rather than filling gaps.

FMP_API_KEY=
EODHD_API_KEY=
TIINGO_API_KEY=
EIA_API_KEY=

# SEC and StatCan require a contact string in the User-Agent, not a key.
LEDGER_CONTACT=you@example.com

# Bank of Canada Valet, Statistics Canada WDS and SEDAR+ need no key.

# Interpretation layer only. This model writes PROSE about numbers the code
# already computed. It is never asked for a figure.
ANTHROPIC_API_KEY=
